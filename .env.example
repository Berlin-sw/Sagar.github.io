# Copy to .env.local for local development, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.
# Only NEXT_PUBLIC_* variables are exposed to the browser. Everything else stays on the server.

# Public URL of the deployed site (used for canonical URLs, Open Graph and the sitemap).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Optional. GitHub token (fine-grained, no extra permissions needed) to enable the
# contribution graph and raise the API rate limit. Server-only.
GITHUB_TOKEN=

# Contact form email delivery via Resend (https://resend.com). Server-only.
# Without these, the form shows a friendly "email me directly" fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional verified sender, e.g. "Portfolio <hello@yourdomain.com>"
CONTACT_FROM_EMAIL=
